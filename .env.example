# ============================================================
# .env.example — 環境変数の雛形
# ============================================================
# 使い方：
#   1) このファイルを .env という名前でコピーする
#        cp .env.example .env
#   2) 下記の手順で各値を自分の環境用に設定する
#   3) .env は .gitignore 済みなのでコミットされない
#
# なぜ雛形を分けるのか：
#   秘密情報そのものはコミットできないが、「何を設定する必要があるか」は
#   共有しないと、クローンした人がアプリを起動できない。
#   そこで「キー名と説明だけ」をコミットし、値は各自が用意する。
# ============================================================

# JWT（アクセストークン／リフレッシュトークン）の署名に使う秘密鍵。
#
# 必須。未設定だとアプリは起動に失敗する（既定値は意図的に持たせていない）。
#
# 生成方法：
#   openssl rand -base64 48
#
# 制約：
#   - デコード後 32 バイト以上（HS256 の要件。JwtUtil の @PostConstruct が起動時に検証する）
#   - 環境ごとに別の値にする（開発用が漏れても本番に影響しないようにするため）
#   - 一度決めたら変更しない。変更すると発行済みトークンが全て無効になり、
#     全ユーザーが強制ログアウトされる（＝鍵漏洩時は意図的に変更して失効させる）
JWT_SECRET=


# ------------------------------------------------------------
# データベース（MySQL）
# ------------------------------------------------------------
# このファイルは docker-compose からも読まれる。
# つまり「DB を立てるときの資格情報」と「アプリが接続するときの資格情報」が
# 同じ1箇所で決まるので、片方だけ変えて繋がらなくなる事故が起きない。

# DB のユーザー名とパスワード。
#
# 必須。未設定だとアプリは起動に失敗する（JWT_SECRET と同じく既定値を持たせていない）。
# 既定値を書いてしまうと、設定を忘れても起動してしまい設定漏れに気づけないうえ、
# リポジトリを公開した時点で DB の資格情報が公になるため。
#
# ローカル開発では任意の値でよい（例：user / password）。
# docker-compose がこの値で MySQL のユーザーを作成する。
DB_USERNAME=
DB_PASSWORD=

# MySQL の root パスワード。docker-compose が DB コンテナを初期化するときだけ使う。
# 必須。アプリ自身は root では接続しない（アプリは上の DB_USERNAME を使う）。
DB_ROOT_PASSWORD=

# DB の接続先。秘密情報ではなく「環境ごとの接続先」なので、
# 未設定ならローカル開発用の既定値（localhost:3306 / team-flow）が使われる。
# 通常は書かなくてよい。ポートが衝突する場合や、コンテナから繋ぐ場合だけ設定する。
#   DB_HOST=db     … アプリもコンテナで動かし、compose のサービス名で繋ぐ場合
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=team-flow


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------
# ブラウザからの API 呼び出しを許可するフロントエンドのオリジン。カンマ区切りで複数可。
#
# 任意。未設定ならローカルの Vite（http://localhost:5173）が使われる。
# 設定漏れは「フロントから通信できない」という形ですぐ表面化するため、
# 起動失敗ではなく安全側の既定値を持たせている。
#
# デプロイ先では実際のフロントの URL に上書きする：
#   CORS_ALLOWED_ORIGINS=https://example.com,http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173
